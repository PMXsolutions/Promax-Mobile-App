{
  "expo": {
    "name": "Promax",
    "slug": "pmax-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",

    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#030637"
    },
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true,
        "NSLocationWhenInUseUsageDescription": "This app needs access to your location."
      },
      "supportsTablet": true,
      "bundleIdentifier": "com.promax-app",
      "config": {
        "googleMapsApiKey": "AIzaSyAtJmwd6aD38O2iZ2MdQbnyBUuj2wxPP58"
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAtJmwd6aD38O2iZ2MdQbnyBUuj2wxPP58"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.tobby95.pmaxapp"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-document-picker",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#030637",
          "image": "./assets/images/splash-icon.png",

          "imageWidth": 200
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow promax care app to use your location."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "f17d61bd-bf3e-44ed-9b9d-e1ebce65a3e6"
      }
    }
  }
}
