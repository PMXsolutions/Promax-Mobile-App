{
  "expo": {
    "name": "Promax Care",
    "slug": "promax-it-solutions",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#030637"
    },
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": "1.0.0",
    "ios": {
      "deviceFamilies": [1],
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true,
        "NSCameraUsageDescription": "This app needs access to your camera to take and upload pictures.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to upload images.",
        "NSLocationWhenInUseUsageDescription": "This app needs access to your location.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "supportsTablet": false,
      "bundleIdentifier": "au.com.promaxsolutions.promaxcare",
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "au.com.promaxsolutions.promaxcare",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-document-picker",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#030637",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow promax care app to use your location."
        }
      ],
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "e2e19955-9a63-4002-803a-73fee46b337f"
      }
    },
    "owner": "promax-it-solutions",
    "updates": {
      "url": "https://u.expo.dev/e2e19955-9a63-4002-803a-73fee46b337f"
    }
  }
}
