{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "ios": {
        "simulator": true
      },
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_BASEURL": "https://api.promaxcare.com.au/api"
      }
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_BASEURL": "https://api.promaxcare.com.au/api"
      }
    },
    "production": {
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "autoIncrement": true
      },
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_BASEURL": "https://api.promaxcare.com.au/api"
      }
    },
    "company-validation": {
      "environment": "production",
      "distribution": "internal",
      "channel": "company-validation",
      "autoIncrement": false,
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_BASEURL": "https://api.promaxcare.com.au/api",
        "EXPO_PUBLIC_ANDROID_SIGNING_CERT_SHA1": "FE:02:D5:A4:15:7A:D7:D1:19:52:69:BA:C2:DC:D3:39:33:71:71:0D"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "production",
        "releaseStatus": "draft"
      },
      "ios": {}
    },
    "internal": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      }
    },
    "testflight": {
      "ios": {}
    }
  }
}
