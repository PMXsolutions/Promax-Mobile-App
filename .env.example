# Copy to `.env` for local/staging builds. Do not commit real values.
# Never point staging builds at production without explicit approval.

# Required — build purpose. The app refuses mismatched UAT/production hosts.
EXPO_PUBLIC_DEPLOYMENT_ENV=development

# Required — API base including `/api` suffix (no trailing slash beyond that).
# Example staging shape only (replace with authorised non-prod host):
# EXPO_PUBLIC_API_BASEURL=https://staging.example.com/api
EXPO_PUBLIC_API_BASEURL=

# Optional — Google Maps (iOS/Android config via app.config.js)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Required for Android push notifications in preview/production EAS builds.
# Configure this as an EAS file secret; do not commit the JSON credential file.
GOOGLE_SERVICES_JSON=
